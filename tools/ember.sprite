# ember: an original example buddy for dev-dash (free to use). Build it with:
#   python tools/make-buddy.py tools/ember.sprite
name ember
mouth 8 4                     # where its fire comes out, facing right
colour F #ffd23c              # flame tip
colour O #ff8a2a              # body
colour R #e0461e              # body shade
colour K #3a2a30              # eyes
colour W #fff4c8              # cheeks

mood idle sit zzz 900         # mood <idle|working|needs> <motion> <effect> [ms per frame]
